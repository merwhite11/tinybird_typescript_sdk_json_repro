+  it("serializes object (p.json) query params as JSON strings", async () => {
+    let configOverridesParam: string | null = null;
+
+    server.use(
+      http.get(`${BASE_URL}/v0/pipes/json_echo.json`, ({ request }) => {
+        const url = new URL(request.url);
+        configOverridesParam = url.searchParams.get("configOverrides");
+        return HttpResponse.json({ data: [], meta: [], rows: 0 });
+      })
+    );
+
+    const api = createTinybirdApi({
+      baseUrl: BASE_URL,
+      token: "p.default-token",
+    });
+
+    await api.query("json_echo", {
+      configOverrides: { foo: 1, nested: { bar: [true, "x"] } },
+    });
+
+    // Without the fix this is "[object Object]", which the server rejects with
+    // "Error parsing JSON". The server's JSON() function json.loads() this.
+    expect(configOverridesParam).toBe(
+      JSON.stringify({ foo: 1, nested: { bar: [true, "x"] } })
+    );
+  });
+
+  it("serializes an array of objects as a single JSON string", async () => {
+    let filtersParam: string[] = [];
+
+    server.use(
+      http.get(`${BASE_URL}/v0/pipes/json_echo.json`, ({ request }) => {
+        const url = new URL(request.url);
+        filtersParam = url.searchParams.getAll("filters");
+        return HttpResponse.json({ data: [], meta: [], rows: 0 });
+      })
+    );
+
+    const api = createTinybirdApi({
+      baseUrl: BASE_URL,
+      token: "p.default-token",
+    });
+
+    await api.query("json_echo", { filters: [{ op: "eq" }, { op: "gt" }] });
+
+    // A JSON array param is one value, not multiple appended entries.
+    expect(filtersParam).toEqual([JSON.stringify([{ op: "eq" }, { op: "gt" }])]);
+  });
+
+  it("keeps appending primitive arrays as repeated params (Array params)", async () => {
+    let tagsParams: string[] = [];
+
+    server.use(
+      http.get(`${BASE_URL}/v0/pipes/top_pages.json`, ({ request }) => {
+        const url = new URL(request.url);
+        tagsParams = url.searchParams.getAll("tags");
+        return HttpResponse.json({ data: [], meta: [], rows: 0 });
+      })
+    );
+
+    const api = createTinybirdApi({
+      baseUrl: BASE_URL,
+      token: "p.default-token",
+    });
+
+    await api.query("top_pages", { tags: ["a", "b"] });
+
+    expect(tagsParams).toEqual(["a", "b"]);
+  });
+
