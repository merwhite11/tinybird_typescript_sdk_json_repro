 const DEFAULT_INGEST_RETRY_503_BASE_DELAY_MS = 200;
 const DEFAULT_INGEST_RETRY_503_MAX_DELAY_MS = 3000;
 
+/**
+ * Whether a query-param value must be serialized as JSON (a `p.json()` param)
+ * rather than stringified with `String()`. Plain objects qualify; arrays and
+ * Dates are handled separately by the caller.
+ */
+function isJsonParamValue(value: unknown): boolean {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    !Array.isArray(value) &&
+    !(value instanceof Date)
+  );
+}
+
+function dateNotSupportedMessage(key: string): string {
+  return (
+    `Date values are not supported for query parameter "${key}". ` +
+    "Pass a string in YYYY-MM-DD HH:MM:SS format (or YYYY-MM-DD HH:MM:SS.sss for DateTime64)."
+  );
+}
+
 /**
  * Public, decoupled Tinybird API wrapper configuration
  */
@@ -213,12 +234,17 @@ export class TinybirdApi {
       }
 
       if (Array.isArray(value)) {
+        // An array containing objects is a JSON-typed param (`p.json()`);
+        // Array() params only ever hold primitives. Serialize the whole array
+        // as a single JSON string rather than appending "[object Object]" per
+        // element.
+        if (value.some(isJsonParamValue)) {
+          url.searchParams.set(key, JSON.stringify(value));
+          continue;
+        }
         for (const item of value) {
